# Copy to `.env` in the repo root (server loads this path; Prisma CLI uses it via server scripts).

DATABASE_URL=postgresql://user:password@localhost:5432/leadflow
# Docker: if port 5432 is already in use, map the container to 5433 and use:
# DATABASE_URL=postgresql://leadflow:leadflow@127.0.0.1:5433/leadflow

# API server (Express)
PORT=3001
NODE_ENV=development

# Optional — Vite dev proxy target (default http://localhost:3001).
# Docker Compose sets this in the client container to http://server:3001
# VITE_API_PROXY=http://localhost:3001
