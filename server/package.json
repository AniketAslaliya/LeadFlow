{
  "name": "leadflow-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "test": "dotenv -e ../.env -- vitest run",
    "test:watch": "dotenv -e ../.env -- vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  }
}
